{
  "name": "ts-patch-mongoose",
  "version": "3.1.0",
  "description": "Patch history & events for mongoose models",
  "author": "ilovepixelart",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilovepixelart/ts-patch-mongoose.git"
  },
  "bugs": {
    "url": "https://github.com/ilovepixelart/ts-patch-mongoose/issues"
  },
  "homepage": "https://github.com/ilovepixelart/ts-patch-mongoose#readme",
  "directories": {
    "examples": "examples"
  },
  "keywords": [
    "backend",
    "mongoose",
    "plugin",
    "mongo",
    "schema",
    "db",
    "nosql",
    "ts",
    "typescript",
    "patch",
    "history",
    "event",
    "emit",
    "create",
    "update",
    "delete",
    "audit",
    "log"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "src",
    "tests",
    "tsconfig.json",
    "vite.config.mts",
    "biome.json"
  ],
  "type": "module",
  "exports": {
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "scripts": {
    "prepare": "simple-git-hooks",
    "biome": "npx @biomejs/biome check",
    "biome:fix": "npx @biomejs/biome check --write .",
    "test": "vitest run --coverage",
    "test:open": "vitest run --coverage && open-cli coverage/lcov-report/index.html",
    "type:check": "tsc --noEmit",
    "build": "pkgroll --clean-dist",
    "release": "npm install && npm run biome && npm run type:check && npm run build && np --no-publish"
  },
  "dependencies": {
    "fast-json-patch": "3.1.1",
    "power-assign": "0.2.10"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@types/node": "25.5.2",
    "@vitest/coverage-v8": "4.1.2",
    "mongodb-memory-server": "11.0.1",
    "mongoose": "9.4.1",
    "np": "11.0.3",
    "open-cli": "9.0.0",
    "pkgroll": "2.27.0",
    "simple-git-hooks": "2.13.1",
    "typescript": "6.0.2",
    "vitest": "4.1.2"
  },
  "peerDependencies": {
    "mongoose": ">=6.6.0 < 10"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run type:check",
    "pre-push": "npm run biome:fix"
  },
  "np": {
    "publish": false
  },
  "overrides": {
    "tmp": "0.2.5",
    "file-type": "21.3.2"
  }
}
